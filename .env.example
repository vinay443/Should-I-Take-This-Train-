# Copy to .env and fill in. .env is gitignored, so never commit real values.

# Path to the DuckDB database file, relative to the working directory.
SITT_DB_PATH=data/sitt.duckdb

# Logging level: DEBUG, INFO, WARNING, ERROR.
SITT_LOG_LEVEL=INFO

# User-Agent the live collector sends. Optional. The default names this project.
# SITT_USER_AGENT=

# m-Indicator (Mobond) is polled only when BOTH of these are exactly true. The first says
# you want it on; the second says Mobond has agreed to it. Leave both false until then.
# See "Turning Mobond on" in docs/data-sources.md.
SITT_MOBOND_ENABLED=false
SITT_MOBOND_PERMISSION_CONFIRMED=false
# The shortest gap between requests to Mobond, in minutes. Never less than 15.
# SITT_MOBOND_MIN_INTERVAL_MINUTES=15

# Telegram bot token from @BotFather. See docs/bot-setup.md. Anyone with it controls the bot.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot, e.g. 123456789,987654321.
# The bot refuses to start while this is empty.
ALLOWED_USER_IDS=

# Folder holding the trained delay model (python -m sitt.models train). Optional.
# SITT_MODEL_DIR=models/delay

# "Take this train or wait?" thresholds. Optional; the defaults are shown.
# How many upcoming trains /next compares.
# SITT_RECOMMEND_CANDIDATES=5
# Wait for an emptier train only if it arrives within this many minutes of the earliest...
# SITT_WAIT_MAX_EXTRA_MINUTES=5
# ...and is at least this many crowding levels (1-5 scale) emptier.
# SITT_CROWD_GAIN_LEVELS=1
# A train predicted this many minutes late at your station counts as "very late"...
# SITT_VERY_LATE_MINUTES=15
# ...and is passed over if another train arrives within this many minutes of it.
# SITT_VERY_LATE_SLACK_MINUTES=10
# Ladies' specials are listed but never recommended, unless you can board them.
# SITT_LADIES_SPECIAL_OK=false
# Use a delay model even if it was trained on synthetic (invented) data. For testing only.
# Left off, such a model is ignored and /next gives timetable times.
# SITT_ALLOW_SYNTHETIC_MODEL=false

# A megablock recorded without times is assumed to run between these hours (HH:MM).
# SITT_BLOCK_DEFAULT_START=10:00
# SITT_BLOCK_DEFAULT_END=16:00

# Collector health report and alerts (sitt-health). See docs/collector.md. Optional.
# Really send Telegram messages. Left off, sitt-health prints what it would send.
# SITT_TELEGRAM_SEND=false
# How often the collector is scheduled, and how late a run may be before it counts as a gap.
# SITT_COLLECT_CADENCE_MINUTES=15
# SITT_HEALTH_GAP_TOLERANCE_MINUTES=10
# Alert when no run has succeeded for this many hours...
# SITT_ALERT_NO_RUN_HOURS=3
# ...when a source failed in this many runs in a row...
# SITT_ALERT_SOURCE_DOWN_RUNS=4
# ...or when its mean readings per run, over its last few answered runs, fall below this.
# SITT_ALERT_MIN_READINGS=10
# SITT_ALERT_READINGS_RUNS=4
# Repeat an alert that is still true no more often than this many hours.
# SITT_ALERT_REPEAT_HOURS=12

# Data-quality bounds (sitt-dq), in minutes. See docs/data-quality.md. Optional.
# SITT_DQ_NEAR_DUPLICATE_MINUTES=5
# SITT_DQ_MAX_EARLY_MINUTES=15
# SITT_DQ_MAX_DELAY_MINUTES=180
# SITT_DQ_MAX_EARLY_MINUTES_LONG_DISTANCE=120
# SITT_DQ_MAX_DELAY_MINUTES_LONG_DISTANCE=1440
# SITT_DQ_JUMP_WINDOW_MINUTES=60
# SITT_DQ_JUMP_SLACK_MINUTES=15
# SITT_DQ_SCHEDULE_MISMATCH_MINUTES=20
# SITT_DQ_FAR_FROM_SCHEDULE_MINUTES=240
# SITT_DQ_FUTURE_TOLERANCE_MINUTES=5
# SITT_DQ_BATCH_TIME_TOLERANCE_MINUTES=90

# Matching /log reports to scheduled trains (docs/crowding.md). Optional.
# A train this many minutes from the reported time scores nothing.
# SITT_MATCH_WINDOW_MINUTES=10
# Below this confidence (0-1) a report is left unmatched rather than risk a wrong train.
# SITT_MATCH_MIN_CONFIDENCE=0.6
# A report may be about a train leaving up to this many minutes after it was logged.
# SITT_MATCH_FUTURE_MINUTES=60
# Trains within this many minutes are offered as buttons, at most this many of them.
# SITT_MATCH_CHOICE_WINDOW_MINUTES=20
# SITT_MATCH_CHOICES=4

# Saved routes, /commute and the bot's own messages (docs/bot-setup.md). Optional.
# From this time of day /commute gives the return leg of a route saved both ways.
# SITT_COMMUTE_RETURN_AFTER=14:00
# Send the recommendation this many minutes before your usual train.
# SITT_COMMUTE_NOTIFY=true
# SITT_COMMUTE_NOTIFY_LEAD_MINUTES=20
# Ask how crowded your usual train was, this many minutes after its scheduled arrival.
# SITT_COMMUTE_NUDGE=true
# SITT_COMMUTE_NUDGE_AFTER_MINUTES=5
# Send neither on Sundays and holidays.
# SITT_COMMUTE_SKIP_SUNDAY_SCHEDULE=true
# A message missed by more than this many minutes is skipped rather than sent late.
# SITT_COMMUTE_GRACE_MINUTES=10
# Your "usual train" is the scheduled train within this many minutes of your usual time.
# SITT_COMMUTE_USUAL_TRAIN_MINUTES=10

# Use holiday dates that aren't officially notified yet (docs/timetable-format.md,
# "Holidays"). Off by default, because such a date may be a day out.
# SITT_HOLIDAYS_INCLUDE_TENTATIVE=false

# Training on real data (sitt-retrain). See docs/retraining.md. Optional.
# Nothing is trained until all of these are met.
# SITT_RETRAIN_MIN_DAYS=28
# SITT_RETRAIN_MIN_OBSERVATIONS=5000
# SITT_RETRAIN_MIN_STATION_OBSERVATIONS=300
# SITT_RETRAIN_MIN_TEST_OBSERVATIONS=500
# SITT_RETRAIN_TEST_WEEKS=1
# SITT_RETRAIN_VALID_WEEKS=1
# A trained model is promoted only if its test MAE beats the best baseline by more than
# this many minutes, and its 10th-90th percentile range holds this share of test rows.
# SITT_PROMOTE_MIN_MAE_GAIN=0
# SITT_PROMOTE_COVERAGE_MIN=0.70
# SITT_PROMOTE_COVERAGE_MAX=0.90

# Experiment: train delay models with the delays of long-distance trains as an extra
# input (docs/long-distance-feature.md). Off by default. Nothing shows it helps yet.
# SITT_FEATURE_LONG_DISTANCE=false
